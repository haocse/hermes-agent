#!/usr/bin/env python3
import argparse
import json
import os
import pathlib
import re
import subprocess
import sys

CMUX = "/Applications/cmux.app/Contents/Resources/bin/cmux"
CMUX_APP = "/Applications/cmux.app"
SESSION_RE = re.compile(r"^[A-Za-z0-9_:-]+$")
SURFACE_RE = re.compile(r"\b(surface:[A-Za-z0-9_-]+|[0-9A-Fa-f-]{36})\b")
WORKSPACE_RE = re.compile(r"\b(workspace:[A-Za-z0-9_-]+)\b")


def cmux_bin() -> str:
    return CMUX if pathlib.Path(CMUX).exists() else "cmux"


def clean_env() -> dict:
    env = dict(os.environ)
    env["CMUX_QUIET"] = "1"
    return env


def open_via_cmux_app(session_id: str) -> int:
    """Fallback for contexts where cmux CLI socket writes fail."""
    state = pathlib.Path.home() / ".local/state/hermes-session-launchers"
    state.mkdir(parents=True, exist_ok=True)
    script = state / f"hermes-session-{session_id}.command"
    script.write_text(
        "#!/bin/zsh\n"
        "cd \"$HOME\"\n"
        f"exec hermes --resume {session_id}\n",
        encoding="utf-8",
    )
    script.chmod(0o755)
    return subprocess.run(["/usr/bin/open", "-a", CMUX_APP, str(script)], check=False).returncode


def debug(msg: str) -> None:
    if os.environ.get("HERMES_SESSION_DEBUG"):
        sys.stderr.write(f"[hermes-session] {msg}\n")


def split_right_and_run(session_id: str) -> int:
    cmux = cmux_bin()
    env = clean_env()

    split_cmd = [cmux, "new-split", "right", "--focus", "true"]
    # In real cmux terminals these env vars identify the clicked pane. However,
    # macOS URL-handler launches can inherit stale UUID values from the parent
    # terminal; passing those explicit UUIDs makes cmux fail with Broken pipe.
    # For non-TTY URL opens, let cmux use its focused workspace defaults.
    use_caller_env = sys.stdout.isatty()
    if use_caller_env and os.environ.get("CMUX_WORKSPACE_ID"):
        split_cmd += ["--workspace", os.environ["CMUX_WORKSPACE_ID"]]
    if use_caller_env and os.environ.get("CMUX_SURFACE_ID"):
        split_cmd += ["--surface", os.environ["CMUX_SURFACE_ID"]]

    debug("running: " + " ".join(split_cmd))
    proc = subprocess.run(split_cmd, capture_output=True, text=True, check=False, env=env)
    debug(f"new-split rc={proc.returncode} stdout={proc.stdout!r} stderr={proc.stderr!r}")
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr or proc.stdout)
        return proc.returncode

    out = (proc.stdout or "") + "\n" + (proc.stderr or "")
    m = SURFACE_RE.search(out)
    if not m:
        sys.stderr.write(f"Could not parse cmux split output: {out}\n")
        return 1
    surface = m.group(1)
    workspace_match = WORKSPACE_RE.search(out)
    workspace = workspace_match.group(1) if workspace_match else None

    command = f"cd {pathlib.Path.home()} && exec hermes --resume {session_id}"

    # Use the public tmux-compatible `send`/`send-key` commands instead of raw
    # `rpc surface.send_text`. The raw RPC path works from an interactive shell
    # but can hit Broken pipe when invoked by a macOS URL handler. `cmux send`
    # is stable from AppleScript/LaunchServices and still targets the split we
    # just created.
    send_cmd = [cmux, "send"]
    if workspace:
        send_cmd += ["--workspace", workspace]
    send_cmd += ["--surface", surface, command]
    debug("running: " + " ".join(send_cmd[:-1]) + " " + repr(command))
    send = subprocess.run(send_cmd, capture_output=True, text=True, check=False, env=env)
    debug(f"send rc={send.returncode} stdout={send.stdout!r} stderr={send.stderr!r}")
    if send.returncode != 0:
        sys.stderr.write(send.stderr or send.stdout)
        return send.returncode
    enter_cmd = [cmux, "send-key"]
    if workspace:
        enter_cmd += ["--workspace", workspace]
    enter_cmd += ["--surface", surface, "Enter"]
    enter = subprocess.run(enter_cmd, capture_output=True, text=True, check=False, env=env)
    if enter.returncode != 0:
        sys.stderr.write(enter.stderr or enter.stdout)
        return enter.returncode
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Open/resume a Hermes session in a right-side cmux pane")
    parser.add_argument("session_id", help="Hermes session ID, e.g. 20260603_142239_5d329c")
    parser.add_argument("--workspace", action="store_true", help="Open as a new cmux workspace instead of right split")
    args = parser.parse_args()

    session_id = args.session_id.strip()
    if not session_id:
        print("session_id is required", file=sys.stderr)
        return 2
    if not SESSION_RE.match(session_id):
        print("invalid session_id", file=sys.stderr)
        return 2

    if args.workspace:
        return open_via_cmux_app(session_id)

    rc = split_right_and_run(session_id)
    if rc == 0:
        return 0

    # URL handlers sometimes cannot talk to cmux's socket (Broken pipe). Keep a
    # working fallback instead of doing nothing.
    if not sys.stdout.isatty() and pathlib.Path(CMUX_APP).exists():
        return open_via_cmux_app(session_id)
    return rc


if __name__ == "__main__":
    raise SystemExit(main())
