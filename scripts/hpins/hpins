OSC = "\033]8;;{url}\a{text}\033]8;;\a"
CMUX = "/Applications/cmux.app/Contents/Resources/bin/cmux"


def parse_args():
    parser = argparse.ArgumentParser(
        description="Show Hermes Desktop pinned sessions, followed by recent sessions. Cmd-click 'hermes session <id>' to resume in cmux."
    )
    sub = parser.add_subparsers(dest="command")
    open_parser = sub.add_parser("open", help="open/resume a Hermes session in a new cmux workspace")
    open_parser.add_argument("session_id")

    parser.add_argument(
        "-n",
        "--recent",
        type=int,
        default=25,
        help="number of recent non-pinned sessions to show below pins (default: 25)",
    )
    parser.add_argument(
        "--all-recent",
        action="store_true",
        help="show all recent sessions instead of limiting to --recent",
    )
    link_group = parser.add_mutually_exclusive_group()
    link_group.add_argument(
        "--links",
        action="store_true",
        help="force clickable terminal hyperlinks",
    )
    link_group.add_argument(
        "--no-links",
        action="store_true",
        help="disable clickable terminal hyperlinks",
    )
    parser.add_argument(
        "-c", "--compact",
        action="store_true",
        help="compact output (default): show titles only, separated into pinned/recent sections",
    )
    parser.add_argument(
        "-v", "--verbose",
        action="store_true",
        help="verbose output: show IDs, sources, and timestamps",
    )
    parser.add_argument(
        "--manage",
        action="store_true",
        help="interactive multi-select manager: unpin pinned sessions and archive recent sessions",
    )
    parser.add_argument(
        "--chat",
        nargs="?",
        const="",
        metavar="SESSION_ID",
        help="experimental: pick a pinned/recent session and resume it as chat in this terminal; optionally pass SESSION_ID",
    )
    parser.add_argument(
        "--chat-dry-run",
        action="store_true",
        help="with --chat, print the hermes resume command instead of executing it",
    )
    parser.add_argument(
        "--mini-chat",
        nargs="?",
        const="",
        metavar="SESSION_ID",
        help="experimental: hpins-owned terminal chat loop; optionally pass SESSION_ID",
    )
    parser.add_argument(
        "--mini-chat-dry-run",
        action="store_true",
        help="with --mini-chat, print hermes single-turn commands instead of executing them",
    )
    parser.add_argument(
        "--pins-only",
        action="store_true",
        help="show only pinned sessions (or manage pinned only with --manage/--chat/--mini-chat)",
    )
    return parser.parse_args()


def open_session(session_id):
    subprocess.run(["hermes-session", session_id], check=False)


def ensure_url_server():
    try:
        health = subprocess.run(
            ["/usr/bin/curl", "-fsS", "--max-time", "0.3", "http://127.0.0.1:17776/health"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        if health.returncode == 0:
            return
