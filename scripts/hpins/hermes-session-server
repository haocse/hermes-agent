#!/usr/bin/env python3
import http.server
import os
import re
import subprocess
import sys
import threading
import urllib.parse

HOST = "127.0.0.1"
PORT = 17776
SESSION_RE = re.compile(r"^[A-Za-z0-9_:-]+$")
HELPER = "/Users/apple/.local/bin/hermes-session"
LOG = "/tmp/hermes-session-server.log"


def log(msg: str) -> None:
    with open(LOG, "a", encoding="utf-8") as f:
        f.write(msg.rstrip() + "\n")


class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        log("http " + (fmt % args))

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path == "/health":
            self.send_response(204)
            self.end_headers()
            return
        m = re.fullmatch(r"/resume/([^/?#]+)", parsed.path)
        if not m:
            self.send_error(404, "use /resume/<session_id>")
            return
        session_id = urllib.parse.unquote(m.group(1)).strip()
        if not SESSION_RE.match(session_id):
            self.send_error(400, "invalid session_id")
            return

        env = dict(os.environ)
        # Do not let launch/url contexts pass stale caller IDs; cmux will target
        # the currently focused workspace/pane.
        env.pop("CMUX_WORKSPACE_ID", None)
        env.pop("CMUX_SURFACE_ID", None)
        env["PATH"] = "/Users/apple/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
        env["HERMES_SESSION_DEBUG"] = "1"
        log(f"resume {session_id}")
        proc = subprocess.run([HELPER, session_id], capture_output=True, text=True, env=env, timeout=15)
        if proc.stdout:
            log(proc.stdout)
        if proc.stderr:
            log(proc.stderr)
        if proc.returncode != 0:
            body = (proc.stderr or proc.stdout or f"exit {proc.returncode}").encode()
            self.send_response(500)
            self.end_headers()
            self.wfile.write(body)
            return
        self.send_response(204)
        self.end_headers()


def main() -> int:
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    server = http.server.ThreadingHTTPServer((HOST, PORT), Handler)
    log(f"listening http://{HOST}:{PORT}")
    server.serve_forever()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
